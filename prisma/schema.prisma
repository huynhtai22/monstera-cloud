generator client {
  provider      = "prisma-client-js"
  // Keep "native" for local dev, add Vercel's Linux runtime target.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String?           @unique
  hashedPassword String?
  emailVerified  DateTime?
  image          String?
  otp            String?
  otpExpires     DateTime?
  plan           String            @default("free")
  subscriptionId String?           @unique
  accounts       Account[]
  sessions       Session[]
  workspaces     WorkspaceMember[]
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  ownerId         String
  /// Optional Telegram chat ID for this workspace (sync failure alerts). Falls back to TELEGRAM_CHAT_ID env.
  telegramChatId  String?
  /// Product demo: overlay synthetic console data for screenshots / feature trials.
  demoMockMode       Boolean @default(false)
  demoMockMeta       Boolean @default(false)
  demoMockShopee     Boolean @default(false)
  demoMockGoogleAds  Boolean @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  clients         Client[]
  connections     Connection[]
  pipelines       Pipeline[]
  members         WorkspaceMember[]
  apiKeys         ApiKey[]
  campaignMetrics CampaignMetric[]
  orders          RetailOrder[]
  utmRules        UtmMappingRule[]
  attributionSnapshots AttributionSnapshot[]
}

model Client {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  description String?
  logoUrl     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelines   Pipeline[]
  connections Connection[]

  @@index([workspaceId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("member")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Connection {
  id                   String           @id @default(cuid())
  workspaceId          String
  clientId             String?          // Agency UX: Group by Client
  name                 String
  type                 String
  provider             String
  credentials          String
  status               String           @default("connected")
  lastError            String?          // UX: Actionable Error Tracking
  lastSyncAt           DateTime?        // UX: Freshness Tracking
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client               Client?          @relation(fields: [clientId], references: [id])
  destinationPipelines Pipeline[]       @relation("DestinationConnection")
  sourcePipelines      Pipeline[]       @relation("SourceConnection")
  campaignMetrics      CampaignMetric[]
  orders              RetailOrder[]
}

model Pipeline {
  id                      String               @id @default(cuid())
  workspaceId             String
  clientId                String?              // Agency UX: Group by Client
  name                    String
  sourceConnectionId      String
  destinationConnectionId String
  scheduleCron            String               @default("0 * * * *")
  status                  String               @default("active")
  healthStatus            String               @default("healthy") // healthy | stale | error
  lastSyncedAt            DateTime?
  syncCursor              String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  client                  Client?              @relation(fields: [clientId], references: [id])
  destinationConnection   Connection           @relation("DestinationConnection", fields: [destinationConnectionId], references: [id])
  sourceConnection        Connection           @relation("SourceConnection", fields: [sourceConnectionId], references: [id])
  workspace               Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs                    SyncLog[]
  transformations         TransformationRule[]
  syncJobs                SyncJob[]
}

model SyncLog {
  id         String   @id @default(cuid())
  pipelineId String
  status     String
  rowsSynced Int      @default(0)
  durationMs Int      @default(0)
  errorMsg   String?
  createdAt  DateTime @default(now())
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

model TransformationRule {
  id         String   @id @default(cuid())
  pipelineId String
  type       String
  config     String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String    @default("Default Key")
  workspaceId String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Job queue for scheduled pipeline syncs.
// Processed by /api/cron/sync-jobs every minute.
// Priority: enterprise=4, professional=3, starter=2, free=1
model SyncJob {
  id          String    @id @default(cuid())
  pipelineId  String
  userId      String
  plan        String    @default("free")
  status      String    @default("queued")  // queued | running | done | failed
  priority    Int       @default(1)
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  scheduledAt DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([status, priority, scheduledAt])
}

model CampaignMetric {
  id           String     @id @default(cuid())
  workspaceId  String
  connectionId String
  platform     String
  accountId    String
  accountName  String?
  campaignId   String
  campaignName String
  adsetId      String?
  adsetName    String?
  date         DateTime
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  spend        Float      @default(0)
  reach        Int?
  cpc          Float?
  ctr          Float?
  conversions  Float?
  revenue      Float?
  roas         Float?
  currency     String     @default("USD")
  rawData      String?
  pulledAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id])
  connection   Connection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, campaignId, date])
  @@index([workspaceId, platform, date])
  @@index([connectionId, date])
  // Added composite indexes to improve filtering by account and combined platform/account/date scans
  @@index([workspaceId, accountId, date])
  @@index([workspaceId, platform, accountId, date])
}

model RetailOrder {
  id            String    @id @default(cuid())
  workspaceId   String
  connectionId  String
  platform      String
  orderId       String
  createdAtIso  String
  currency      String
  grossRevenue  Float
  netRevenue    Float?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  rawData       String?
  pulledAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  connection Connection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, orderId])
  @@index([workspaceId, platform, createdAt])
}

model UtmMappingRule {
  id          String   @id @default(cuid())
  workspaceId String
  type        String   // exact | regex
  pattern     String
  platform    String?  // optional constraint
  campaignId  String?  // optional mapping target
  campaignName String? // optional mapping target
  weight      Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type])
}

model AttributionTouch {
  id           String   @id @default(cuid())
  workspaceId  String
  orderId      String
  platform     String
  campaignId   String?
  campaignName String?
  touchAt      DateTime
  weight       Float
  spendPortion Float?
  createdAt    DateTime @default(now())

  @@index([workspaceId, orderId])
  @@index([workspaceId, touchAt])
}

/// Per-client weekly report schedule. Agencies configure who receives the recap email.
model ReportSchedule {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String?
  cron        String    @default("0 9 * * 1")
  recipients  String    // comma-separated email list
  enabled     Boolean   @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([clientId])
}

model AttributionSnapshot {
  id                String   @id @default(cuid())
  workspaceId       String
  date              DateTime
  attributedRevenue Float    @default(0)
  adSpend           Float    @default(0)
  netRoas           Float    @default(0)
  model             String   @default("time_decay")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date, model])
  @@index([workspaceId, date])
}
