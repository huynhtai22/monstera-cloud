generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String?           @unique
  hashedPassword String?
  emailVerified  DateTime?
  image          String?
  otp            String?
  otpExpires     DateTime?
  plan           String            @default("free")
  subscriptionId String?           @unique
  accounts       Account[]
  sessions       Session[]
  workspaces     WorkspaceMember[]
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  ownerId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  connections     Connection[]
  pipelines       Pipeline[]
  members         WorkspaceMember[]
  apiKeys         ApiKey[]
  campaignMetrics CampaignMetric[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("member")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Connection {
  id                   String           @id @default(cuid())
  workspaceId          String
  name                 String
  type                 String
  provider             String
  credentials          String
  status               String           @default("connected")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  destinationPipelines Pipeline[]       @relation("DestinationConnection")
  sourcePipelines      Pipeline[]       @relation("SourceConnection")
  campaignMetrics      CampaignMetric[]
}

model Pipeline {
  id                      String               @id @default(cuid())
  workspaceId             String
  name                    String
  sourceConnectionId      String
  destinationConnectionId String
  scheduleCron            String               @default("0 * * * *")
  status                  String               @default("active")
  lastSyncedAt            DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  destinationConnection   Connection           @relation("DestinationConnection", fields: [destinationConnectionId], references: [id])
  sourceConnection        Connection           @relation("SourceConnection", fields: [sourceConnectionId], references: [id])
  workspace               Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs                    SyncLog[]
  transformations         TransformationRule[]
  syncJobs                SyncJob[]
}

model SyncLog {
  id         String   @id @default(cuid())
  pipelineId String
  status     String
  rowsSynced Int      @default(0)
  durationMs Int      @default(0)
  errorMsg   String?
  createdAt  DateTime @default(now())
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

model TransformationRule {
  id         String   @id @default(cuid())
  pipelineId String
  type       String
  config     String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String    @default("Default Key")
  workspaceId String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Job queue for scheduled pipeline syncs.
// Processed by /api/cron/sync-jobs every minute.
// Priority: enterprise=4, professional=3, starter=2, free=1
model SyncJob {
  id          String    @id @default(cuid())
  pipelineId  String
  userId      String
  plan        String    @default("free")
  status      String    @default("queued")  // queued | running | done | failed
  priority    Int       @default(1)
  scheduledAt DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([status, priority, scheduledAt])
}

model CampaignMetric {
  id           String     @id @default(cuid())
  workspaceId  String
  connectionId String
  platform     String
  accountId    String
  accountName  String?
  campaignId   String
  campaignName String
  adsetId      String?
  adsetName    String?
  date         DateTime
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  spend        Float      @default(0)
  reach        Int?
  cpc          Float?
  ctr          Float?
  conversions  Float?
  revenue      Float?
  roas         Float?
  currency     String     @default("USD")
  rawData      String?
  pulledAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id])
  connection   Connection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, campaignId, date])
  @@index([workspaceId, platform, date])
  @@index([connectionId, date])
}
