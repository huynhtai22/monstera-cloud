generator client {
  provider      = "prisma-client-js"
  // Keep "native" for local dev, add Vercel's Linux runtime target.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer
}

enum PlatformRole {
  USER
  OPERATOR
}

enum WorkspaceStatus {
  PILOT
  ACTIVE
  SUSPENDED
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String?           @unique
  hashedPassword String?
  emailVerified  DateTime?
  image          String?
  otp            String?
  otpExpires     DateTime?
  otpAttempts    Int               @default(0)
  otpLockedUntil DateTime?
  plan           String            @default("free")
  subscriptionId String?           @unique
  platformRole   PlatformRole      @default(USER)
  accounts       Account[]
  sessions       Session[]
  workspaces     WorkspaceMember[]
  paymentOrders  PaymentOrder[]
}

model Workspace {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  ownerId              String
  plan                 String                @default("free")
  status               WorkspaceStatus       @default(PILOT)
  subscriptionProvider String?
  subscriptionId       String?               @unique
  /// Expiry boundary for domestic-transfer terms and the free trial.
  /// Null preserves legacy workspaces until they are explicitly renewed.
  subscriptionEndsAt   DateTime?
  /// Optional Telegram chat ID for this workspace (sync failure alerts). Falls back to TELEGRAM_CHAT_ID env.
  telegramChatId       String?
  /// Product demo: overlay synthetic console data for screenshots / feature trials.
  demoMockMode         Boolean               @default(false)
  demoMockMeta         Boolean               @default(false)
  demoMockShopee       Boolean               @default(false)
  demoMockGoogleAds    Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  clients              Client[]
  connections          Connection[]
  pipelines            Pipeline[]
  members              WorkspaceMember[]
  apiKeys              ApiKey[]
  campaignMetrics      CampaignMetric[]
  shopeeCampaigns      ShopeeCampaign[]
  shopeeProducts       ShopeeProduct[]
  providerSyncRuns     ProviderSyncRun[]
  orders               RetailOrder[]
  utmRules             UtmMappingRule[]
  attributionSnapshots AttributionSnapshot[]

  // OBSERVABILITY: Data quality rules and violations
  dataQualityRules      DataQualityRule[]
  dataQualityViolations DataQualityViolation[]

  // TEMPLATES: User dashboards
  userDashboards UserDashboard[]

  // Looker Studio integration jobs
  lookerJobs          LookerJob[]
  warehouseImportJobs WarehouseImportJob[]
  providerAccess      WorkspaceProviderAccess[]
  invitations         WorkspaceInvitation[]
  oauthAttempts       OAuthAttempt[]
  auditEvents         AuditEvent[]
  supportTickets      SupportTicket[]
  aiPolicy            WorkspaceAiPolicy?
  agentJobs           AgentJob[]
  agentTraces         AgentTrace[]
  evidencePacks       EvidencePackRecord[]
  payloadDiscoveries  PayloadSchemaDiscovery[]
  schemaProposals     SchemaPatchProposal[]
  paymentOrders       PaymentOrder[]
  providerAccountHealth ProviderAccountHealth[]

  @@index([subscriptionProvider, subscriptionEndsAt])
}

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  description String?
  logoUrl     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelines   Pipeline[]
  connections Connection[]

  @@index([workspaceId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceProviderAccess {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  enabled     Boolean   @default(true)
  enabledAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId, enabled])
}

model WorkspaceInvitation {
  id               String        @id @default(cuid())
  tokenHash        String        @unique
  email            String
  role             WorkspaceRole @default(member)
  workspaceId      String?
  agencyName       String?
  agencySlug       String?
  plan             String?
  enabledProviders String[]
  invitedByUserId  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime      @default(now())
  workspace        Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@index([workspaceId, acceptedAt])
}

model OAuthAttempt {
  id                    String    @id @default(cuid())
  tokenHash             String    @unique
  userId                String
  workspaceId           String
  provider              String
  reconnectConnectionId String?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, provider, expiresAt])
  @@index([workspaceId, consumedAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
}

model Connection {
  id                   String           @id @default(cuid())
  workspaceId          String
  clientId             String? // Agency UX: Group by Client
  name                 String
  type                 String
  provider             String
  credentials          String
  remoteAccountId      String           @default("") // Identity key for deduplication (e.g. adAccountId, shop domain)
  status               String           @default("connected")
  lastError            String? // UX: Actionable Error Tracking
  lastSyncAt           DateTime? // UX: Freshness Tracking
  lastDataThrough      DateTime? // Latest CampaignMetric.date for this connection; not the sync clock
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client               Client?          @relation(fields: [clientId], references: [id])
  destinationPipelines Pipeline[]       @relation("DestinationConnection")
  sourcePipelines      Pipeline[]       @relation("SourceConnection")
  campaignMetrics      CampaignMetric[]
  orders               RetailOrder[]
  shopeeCampaigns      ShopeeCampaign[]
  shopeeProducts       ShopeeProduct[]
  shopeeCatalogState   ShopeeCatalogSyncState?
  providerSyncRuns     ProviderSyncRun[]
  accountHealth        ProviderAccountHealth[]

  @@unique([workspaceId, provider, remoteAccountId])
}

model Pipeline {
  id                      String               @id @default(cuid())
  workspaceId             String
  clientId                String? // Agency UX: Group by Client
  name                    String
  sourceConnectionId      String
  destinationConnectionId String
  scheduleCron            String               @default("0 * * * *")
  status                  String               @default("active")
  healthStatus            String               @default("healthy") // healthy | stale | error
  lastSyncedAt            DateTime?
  syncCursor              String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  client                  Client?              @relation(fields: [clientId], references: [id])
  destinationConnection   Connection           @relation("DestinationConnection", fields: [destinationConnectionId], references: [id])
  sourceConnection        Connection           @relation("SourceConnection", fields: [sourceConnectionId], references: [id])
  workspace               Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs                    SyncLog[]
  transformations         TransformationRule[]
  syncJobs                SyncJob[]
}

model SyncLog {
  id         String   @id @default(cuid())
  pipelineId String
  status     String
  rowsSynced Int      @default(0)
  durationMs Int      @default(0)
  errorMsg   String?
  createdAt  DateTime @default(now())
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

model SyncCheckpoint {
  id            String   @id @default(cuid())
  pipelineId    String
  jobId         String?
  entityType    String   @default("campaign")
  cursor        String
  rowsProcessed Int      @default(0)
  rowsInserted  Int      @default(0)
  rowsFailed    Int      @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pipelineId, status])
  @@index([jobId])
}

model TransformationRule {
  id         String @id @default(cuid())
  pipelineId String
  type       String
  config     String
  orderIndex Int    @default(0)

  // In-flight normalization: custom field calculations
  formula     String? // e.g. "spend * 1.2"
  targetField String? // output field name
  dependsOn   String[] // input field names
  condition   String? // filter expression

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pipeline  Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  legacyKey   String?   @unique @map("key")
  keyHash     String?   @unique
  keyPrefix   String?
  keyLastFour String?
  name        String    @default("Default Key")
  workspaceId String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Job queue for scheduled pipeline syncs.
// Processed by /api/cron/sync-jobs every minute.
// Priority: enterprise=4, professional=3, starter=2, free=1
model SyncJob {
  id             String    @id @default(cuid())
  pipelineId     String
  activeKey      String?   @unique
  userId         String
  plan           String    @default("free")
  status         String    @default("queued") // queued | running | done | failed
  priority       Int       @default(1)
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  scheduledAt    DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  leaseId        String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  errorMsg       String?
  createdAt      DateTime  @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([status, priority, scheduledAt])
  @@index([status, leaseExpiresAt])
}

model CampaignMetric {
  id           String  @id @default(cuid())
  workspaceId  String
  connectionId String
  platform     String
  accountId    String
  accountName  String?

  level        String  @default("campaign") // account | campaign | adset | ad
  entityId     String  @default("") // campaign_id | adset_id | ad_id depending on level
  campaignId   String  @default("")
  campaignName String  @default("")
  adsetId      String? @default("")
  adsetName    String?
  adId         String? @default("")

  date          DateTime
  breakdownHash String   @default("none") // SHA-1 of sorted breakdown k=v pairs; "none" = no breakdown

  impressions Int     @default(0)
  clicks      Int     @default(0)
  spend       Float   @default(0)
  reach       Int     @default(0)
  cpc         Float   @default(0)
  ctr         Float   @default(0)
  conversions Float   @default(0)
  revenue     Float   @default(0)
  roas        Float   @default(0)
  currency    String?
  rawData     String?

  syncJobId    String? // which SyncJob wrote this row
  lockScope    String? // SyncLock.scope at write time
  fencingToken BigInt? // SyncLock.fencingToken at write time — stale writes are rejected

  pulledAt   DateTime   @default(now())
  createdAt  DateTime   @default(now())
  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  connection Connection @relation(fields: [connectionId], references: [id])

  // DB-level idempotency key: one row per (connection, account, level, entity, date, breakdown)
  @@unique([connectionId, accountId, level, entityId, date, breakdownHash])
  @@index([workspaceId, platform, date])
  @@index([connectionId, date])
  @@index([workspaceId, accountId, date])
  @@index([workspaceId, platform, accountId, date])
}

/// Provider-discovered Shopee campaign identity. This is intentionally separate
/// from dated performance rows so an empty sandbox performance response cannot
/// be mistaken for zero-valued metrics.
model ShopeeCampaign {
  id                 String   @id @default(cuid())
  workspaceId        String
  connectionId       String
  environment        String
  shopId             String
  region             String
  externalCampaignId String
  adType             String
  biddingStrategy    String?
  campaignName       String?
  campaignStatus     String?
  sourceRequestId    String?
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection         Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, environment, shopId, externalCampaignId])
  @@index([workspaceId, environment, shopId])
  @@index([connectionId, syncedAt])
}

/// Provider-discovered Shopee product identity. Performance remains in
/// CampaignMetric; catalog rows retain their own source timestamp and status.
model ShopeeProduct {
  id               String   @id @default(cuid())
  workspaceId      String
  connectionId     String
  environment      String
  shopId           String
  region           String
  externalItemId   String
  itemName         String?
  itemStatus       String?
  sourceUpdatedAt  DateTime?
  sourceRequestId  String?
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection       Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, environment, shopId, externalItemId])
  @@index([workspaceId, environment, shopId])
  @@index([connectionId, syncedAt])
}

/// Per-connection catalog watermark. The first catalog run deliberately leaves
/// this null and performs a full product scan; subsequent runs overlap it.
model ShopeeCatalogSyncState {
  id                 String   @id @default(cuid())
  connectionId       String   @unique
  productWatermarkAt DateTime?
  updatedAt          DateTime @updatedAt
  connection         Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

/// Sanitized per-endpoint provider call record. It intentionally has no URL,
/// credential, token, request body, or signature fields.
model ProviderSyncRun {
  id                String    @id @default(cuid())
  workspaceId       String
  connectionId      String
  provider          String
  environment       String
  shopId            String?
  endpoint          String
  httpStatus        Int?
  providerRequestId String?
  status            String
  rowsReceived      Int       @default(0)
  rowsWritten       Int       @default(0)
  errorCategory     String?
  errorMessage      String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection        Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, connectionId, startedAt])
  @@index([connectionId, endpoint, startedAt])
}

model RetailOrder {
  id           String   @id @default(cuid())
  workspaceId  String
  connectionId String
  platform     String
  orderId      String
  createdAtIso String
  currency     String
  grossRevenue Float
  netRevenue   Float?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  rawData      String?
  pulledAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  connection Connection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, orderId])
  @@index([workspaceId, platform, createdAt])
}

model UtmMappingRule {
  id           String   @id @default(cuid())
  workspaceId  String
  type         String // exact | regex
  pattern      String
  platform     String? // optional constraint
  campaignId   String? // optional mapping target
  campaignName String? // optional mapping target
  weight       Float    @default(1.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type])
}

model AttributionTouch {
  id           String   @id @default(cuid())
  workspaceId  String
  orderId      String
  platform     String
  campaignId   String?
  campaignName String?
  touchAt      DateTime
  weight       Float
  spendPortion Float?
  createdAt    DateTime @default(now())

  @@index([workspaceId, orderId])
  @@index([workspaceId, touchAt])
}

/// Per-client weekly report schedule. Agencies configure who receives the recap email.
model ReportSchedule {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String?
  cron        String    @default("0 9 * * 1")
  recipients  String // comma-separated email list
  enabled     Boolean   @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([clientId])
}

model AttributionSnapshot {
  id                String   @id @default(cuid())
  workspaceId       String
  date              DateTime
  attributedRevenue Float    @default(0)
  adSpend           Float    @default(0)
  netRoas           Float    @default(0)
  model             String   @default("time_decay")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date, model])
  @@index([workspaceId, date])
}

// OBSERVABILITY: Data Quality Rules - Anomaly detection configuration
model DataQualityRule {
  id          String  @id @default(cuid())
  workspaceId String
  name        String // e.g., "Revenue Drop Alert"
  description String?

  // Rule configuration
  ruleType     String // threshold | comparison | schema_check
  metric       String // revenue | orders | roas | row_count
  operator     String // gt | lt | eq | drop_pct | increase_pct
  threshold    Float? // Absolute threshold
  pctThreshold Float? // Percentage threshold (e.g., 0.5 for 50%)

  // Rule scope
  pipelineId   String? // Apply to specific pipeline or all
  connectionId String? // Apply to specific connection

  // Alerting
  severity        String   @default("warning") // warning | critical
  enabled         Boolean  @default(true)
  notifyEmail     Boolean  @default(false)
  notifyTelegram  Boolean  @default(true)
  expectedColumns String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  violations DataQualityViolation[]

  @@index([workspaceId, enabled])
  @@index([pipelineId, enabled])
}

// OBSERVABILITY: Data Quality Violations - Recorded anomalies
model DataQualityViolation {
  id           String  @id @default(cuid())
  ruleId       String
  workspaceId  String
  pipelineId   String?
  connectionId String?

  // Violation details
  expectedValue Float? // Expected metric value
  actualValue   Float // Actual metric value
  pctChange     Float? // Percentage change from expected

  // Context
  syncLogId  String? // Related sync job
  sampleData String? // JSON sample of problematic rows

  // Status
  status         String    @default("open") // open | acknowledged | resolved | false_positive
  acknowledgedBy String?
  acknowledgedAt DateTime?
  notes          String?

  createdAt DateTime @default(now())

  rule      DataQualityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([ruleId, createdAt])
  @@index([createdAt])
}

// OBSERVABILITY: Enhanced Sync Log with row-level details
model SyncLogDetail {
  id        String @id @default(cuid())
  syncLogId String

  // Granular sync information
  stage  String // extract | transform | load
  status String // success | warning | error

  // Metrics
  rowsProcessed Int @default(0)
  rowsInserted  Int @default(0)
  rowsUpdated   Int @default(0)
  rowsFailed    Int @default(0)

  // Performance
  durationMs       Int @default(0)
  apiCalls         Int @default(0)
  bytesTransferred Int @default(0)

  // Error tracking
  errorCode    String?
  errorMessage String?
  errorDetails String? // JSON stack/error details

  // Schema tracking
  schemaVersion String? // API schema version at time of sync

  createdAt DateTime @default(now())

  @@index([syncLogId, stage])
  @@index([createdAt])
}

// OBSERVABILITY: Schema Version Tracking
model SchemaVersion {
  id           String @id @default(cuid())
  connectionId String
  provider     String // meta_ads | google_ads | etc.

  // Schema identification
  version    String // e.g., "v12.0" for Meta Marketing API
  schemaHash String // Hash of discovered schema

  // Schema content (snapshot)
  fields      String // JSON array of {name, type, nullable}
  primaryKeys String? // JSON array of primary key fields

  // Change detection
  discoveredAt    DateTime @default(now())
  breakingChanges Int      @default(0) // Count of breaking changes from previous

  // Status
  isActive     Boolean   @default(true)
  deprecatedAt DateTime?

  @@unique([connectionId, version])
  @@index([provider, discoveredAt])
}

// TEMPLATES: Pre-built Dashboard Templates
model DashboardTemplate {
  id   String @id @default(cuid())
  slug String @unique // meta-ads-roas | shopee-sales | etc.

  name        String
  description String
  category    String // ads | marketplace | analytics

  // Template configuration
  config String // JSON: { sources: [], widgets: [], filters: [] }

  // Requirements
  requiredSources String[] // e.g., ["meta_ads", "google_ads"]
  requiredMetrics String[] // e.g., ["spend", "revenue", "roas"]

  // Display
  previewImage String?
  isFeatured   Boolean @default(false)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TEMPLATES: User Dashboard Instances
model UserDashboard {
  id          String  @id @default(cuid())
  workspaceId String
  templateId  String?

  name        String
  description String?

  // Configuration (overrides template)
  config String // JSON: user customizations

  // Filters
  dateRange String  @default("last_30_days") // today | last_7 | last_30 | last_90 | custom
  filters   String? // JSON: { platforms: [], campaigns: [], etc }

  isDefault Boolean @default(false)
  isShared  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isDefault])
}

// Persisted metadata for Looker Studio export jobs
model LookerJob {
  id          String    @id
  workspaceId String
  apiKeyId    String?
  params      Json
  status      String    @default("queued") // queued | running | done | failed
  resultKey   String? // S3 object key
  resultUrl   String?
  rowCount    Int?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// PostgreSQL advisory-lock-backed sync ownership table.
/// Prevents two concurrent workers from syncing the same Meta ad account.
/// Scope key: meta_ads:{workspaceId}:{connectionId}:{adAccountId}
model SyncLock {
  scope        String @id // deterministic scope string
  provider     String
  workspaceId  String
  connectionId String
  accountId    String

  jobId        String?
  leaseId      String // random UUID per claim
  fencingToken BigInt // monotonically increments on every claim

  status         String   @default("running") // running | released | failed
  heartbeatAt    DateTime
  leaseExpiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, workspaceId, accountId])
  @@index([leaseExpiresAt])
  @@index([jobId])
}

// Durable execution for asynchronous warehouse batch imports
model WarehouseImportJob {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  plan           String    @default("pilot")
  since          String
  until          String
  items          Json      // BatchImportItem[]
  status         String    @default("queued") // queued | running | completed | partial | failed
  totalItems     Int       @default(0)
  completedItems Int       @default(0)
  approximateRows Int      @default(0)
  results        Json?     // BatchImportJobResult[]
  errorMsg       String?
  priority       Int       @default(1)
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  leaseId        String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  scheduledAt    DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
  @@index([status, scheduledAt])
  @@index([status, leaseExpiresAt])
}

model WorkspaceAiPolicy {
  workspaceId                    String    @id
  enabledFeatures                String[]
  monthlyTokenBudget             Int       @default(2000000)
  monthlyUsdBudget               Float     @default(25)
  budgetWriteOptIn               Boolean   @default(false)
  acknowledgeBestEffortDefault   Boolean   @default(false)
  updatedAt                      DateTime  @updatedAt
  workspace                      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentJob {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String?
  type           String
  status         String    @default("queued")
  payload        Json
  result         Json?
  errorMsg       String?
  promptVersion  String?
  model          String?
  provider       String?
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  costUsd        Float     @default(0)
  refusalCode    String?
  priority       Int       @default(1)
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  leaseId        String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  scheduledAt    DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([workspaceId, createdAt])
  @@index([status, leaseExpiresAt])
}

model AgentTrace {
  id          String   @id @default(cuid())
  workspaceId String
  jobId       String
  step        Int
  toolName    String?
  toolArgs    Json?
  toolResult  Json?
  durationMs  Int
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, jobId])
}

model EvidencePackRecord {
  id          String   @id @default(cuid())
  workspaceId String
  jobId       String
  pack        Json
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, jobId])
}

model PayloadSchemaDiscovery {
  id           String   @id @default(cuid())
  workspaceId  String
  connectionId String
  provider     String
  schemaHash   String
  fields       String
  discoveredAt DateTime @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([connectionId, schemaHash])
  @@index([workspaceId, provider, discoveredAt])
}

model SchemaPatchProposal {
  id            String    @id @default(cuid())
  workspaceId   String
  connectionId  String
  provider      String
  status        String    @default("pending")
  addedFields   String
  removedFields String
  mappingDelta  String
  breaking      Boolean   @default(false)
  note          String?
  decidedAt     DateTime?
  decidedBy     String?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
}

model SupportTicket {
  id             String    @id @default(cuid())
  workspaceId    String
  status         String    @default("open")
  reason         String
  title          String
  tag            String?
  errorMsg       String?
  runId          String?
  connectionId   String?
  pipelineId     String?
  notes          String?
  fingerprint    String
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, fingerprint])
}

enum PaymentOrderStatus {
  CREATING
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
}

model PaymentOrder {
  id                 String             @id @default(cuid())
  orderCode          BigInt             @unique
  workspaceId        String
  userId             String?
  plan               String
  billingCycle       String
  amount             Int
  currency           String             @default("VND")
  accessDurationDays Int                @default(30)
  status             PaymentOrderStatus @default(CREATING)
  paymentLinkId      String?            @unique
  checkoutUrl        String?
  qrCode             String?
  transactionRef     String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  expiresAt          DateTime
  paidAt             DateTime?
  fulfilledAt        DateTime?
  updatedAt          DateTime           @updatedAt
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([orderCode])
  @@index([expiresAt])
}

model ProviderAccountHealth {
  id                  String     @id @default(cuid())
  workspaceId         String
  connectionId        String
  provider            String
  accountId           String
  accountName         String?
  status              String     @default("healthy") // healthy | degraded | quarantined | reconnect_required
  errorCategory       String?    // AUTH_EXPIRED | PERMISSION_DENIED | RATE_LIMITED | SCHEMA_DRIFT | TRANSIENT_NETWORK | UNKNOWN
  consecutiveFailures Int        @default(0)
  lastError           String?
  lastErrorAt         DateTime?
  lastSuccessAt       DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  workspace           Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection          Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, accountId])
  @@index([workspaceId, provider, status])
  @@index([connectionId, status])
}
