    const { slug } = await params;
    const data = DATA[slug] ?? DATA["tiktok-ads-to-google-sheets"];
    const baseKeywords = [
        data.source,
        data.dest,
        "integration",
        "Southeast Asia",
        "ecommerce data pipeline",
