@import "tailwindcss";

/* ── Tailwind v4 custom design tokens ──────────────────────────────────────
   In v4 the JS config alone doesn't generate utility classes for custom
   colors — they must be declared here via @theme so that classes like
   bg-primary, hover:bg-primary-hover, text-primary-ring, etc. are emitted.
   ─────────────────────────────────────────────────────────────────────────── */
@theme {
  --color-primary: #0891b2;
  --color-primary-foreground: #ffffff;
  --color-primary-muted: #ecfeff;
  --color-primary-ring: #06b6d4;
  --color-primary-hover: #0e7490;
  --color-surface-muted: #f9fafb;
}

@custom-variant dark (&:where(.dark, .dark *));

:root {
    --background: #f8fafc;
    /* slate-50 */
    --foreground: #0f172a;
    /* slate-900 */
}

/* Design tokens and animation durations (moved from UI system modules) */
:root {
        /*
            UI system tokens (RGB triplets) — used by CSS Modules in src/components/ui/system/*.
            NOTE: Do not override Tailwind's `--color-*` variables here; Tailwind v4 emits utilities
            like `bg-primary` using `--color-primary` from @theme above.
        */
        --ui-bg-rgb: 255 255 255;
        --ui-fg-rgb: 15 23 42;
        --ui-border-rgb: 226 232 240; /* slate-200 */
        --ui-muted-bg-rgb: 248 250 252; /* slate-50 */
        --ui-muted-fg-rgb: 100 116 139; /* slate-500 */
        --ui-primary-rgb: 8 145 178;
        --ui-primary-foreground-rgb: 255 255 255;

    /* Spacing scale (base 4px) */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-card: 20px;

    /* Radii */
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 12px;

    /* Shadows — enhanced depth */
    --shadow-card: 0 6px 18px rgba(2,6,23,0.06);
    --shadow-elevated: 0 12px 32px rgba(2,6,23,0.08);
    --shadow-glow: 0 0 24px rgba(8, 145, 178, 0.12);
    --shadow-soft: 0 4px 12px rgba(2,6,23,0.04);
    --shadow-depth: 0 20px 48px rgba(2,6,23,0.12);

    /* Animation durations */
    --dur-short: 180ms;
    --dur-medium: 320ms;
    --dur-long: 500ms;
    --anim-short: 180ms;
    --anim-medium: 320ms;
    --anim-ease: cubic-bezier(.2,.9,.2,1);
    --anim-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    /* Premium spring easing — momentum-based, non-robotic */
    --spring: cubic-bezier(0.25, 1, 0.5, 1);
}

.dark {
    /* Slightly lifted from slate-950 so surfaces/cards can separate clearly */
    --background: #0f172a;
    /* slate-900 */
    --foreground: #f1f5f9;
    /* slate-100 — slightly softer than pure white on black */

    /* UI system tokens (RGB triplets) */
    --ui-bg-rgb: 15 23 42;
    --ui-fg-rgb: 241 245 249;
    --ui-border-rgb: 51 65 85; /* slate-700 */
    --ui-muted-bg-rgb: 30 41 59; /* slate-800 */
    --ui-muted-fg-rgb: 148 163 184; /* slate-400 */
}

body {
    color: var(--foreground);
    background: var(--background);
}

/* Used during theme toggle to avoid transition flash (see AppLayout) */
html.disable-transitions *,
html.disable-transitions *::before,
html.disable-transitions *::after {
    transition: none !important;
}

/* ── Enhanced Dashboard Animations ──────────────────────────────────────── */

/* Staggered fade/rise for dashboard cards */
@keyframes pillarFadeUp {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.pillar-fade {
    animation: pillarFadeUp 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* Metric card entrance with scale */
@keyframes metricCardEntry {
    from {
        opacity: 0;
        transform: scale(0.95) translateY(12px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.metric-card-enter {
    animation: metricCardEntry 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* Smooth gauge circle animation */
@keyframes gaugeStroke {
    from {
        stroke-dashoffset: 100%;
    }
    to {
        stroke-dashoffset: var(--offset);
    }
}

.gauge-animate {
    animation: gaugeStroke 800ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* Subtle pulse for accent elements */
@keyframes accentPulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.7;
    }
}

.accent-pulse {
    animation: accentPulse 3s ease-in-out infinite;
}

/* Gentle drift for floating elements */
@keyframes gentleDrift {
    0%, 100% {
        transform: translateY(0px);
    }
    50% {
        transform: translateY(-2px);
    }
}

.drift-float {
    animation: gentleDrift 4s ease-in-out infinite;
}

/* Error state pulse — soft red shadow on bento cards with connection errors */
@keyframes errorPulse {
    0%, 100% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
    }
    50% {
        box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.12);
    }
}

/* Animated dashed bridge connector (Stage 1 onboarding) */
@keyframes dashMove {
    to {
        stroke-dashoffset: -20;
    }
}

/* ── Staggered list-item entrance ────────────────────────────────────────── */
@keyframes fadeSlideUp {
    from {
        opacity: 0;
        transform: translateY(6px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.stagger-item {
    animation: fadeSlideUp 380ms var(--spring, cubic-bezier(0.25, 1, 0.5, 1)) both;
}

/* Apply via index: nth-child selectors for up to 12 items */
.stagger-list > *:nth-child(1)  { animation-delay:  0ms; }
.stagger-list > *:nth-child(2)  { animation-delay: 50ms; }
.stagger-list > *:nth-child(3)  { animation-delay: 100ms; }
.stagger-list > *:nth-child(4)  { animation-delay: 150ms; }
.stagger-list > *:nth-child(5)  { animation-delay: 200ms; }
.stagger-list > *:nth-child(6)  { animation-delay: 250ms; }
.stagger-list > *:nth-child(7)  { animation-delay: 300ms; }
.stagger-list > *:nth-child(8)  { animation-delay: 350ms; }
.stagger-list > *:nth-child(9)  { animation-delay: 400ms; }
.stagger-list > *:nth-child(10) { animation-delay: 450ms; }
.stagger-list > *:nth-child(11) { animation-delay: 500ms; }
.stagger-list > *:nth-child(12) { animation-delay: 550ms; }

/* ── Status dot pulse variants ───────────────────────────────────────────── */

/* Healthy / connected — slow, calming green pulse */
@keyframes pulseHealthy {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
    50%       { box-shadow: 0 0 0 5px rgba(34, 197, 94, 0); }
}
.pulse-healthy {
    animation: pulseHealthy 2.8s ease-in-out infinite;
}

/* Stale / warning — faster amber pulse */
@keyframes pulseStale {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.5); }
    50%       { box-shadow: 0 0 0 4px rgba(245, 158, 11, 0); }
}
.pulse-stale {
    animation: pulseStale 1.8s ease-in-out infinite;
}

/* Error — red heartbeat shadow */
@keyframes pulseError {
    0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
    50%       { box-shadow: 0 0 0 5px rgba(239, 68, 68, 0); }
}
.pulse-error {
    animation: pulseError 1.4s ease-in-out infinite;
}

/* ── Bento spring hover — reusable utility ───────────────────────────────── */
.bento-hover {
    transition: transform 300ms var(--spring, cubic-bezier(0.25,1,0.5,1)),
                box-shadow 300ms var(--spring, cubic-bezier(0.25,1,0.5,1));
}
.bento-hover:hover {
    transform: scale(1.02) translateY(-1px);
    box-shadow: 0 12px 32px rgba(2,6,23,0.10);
}

@media (prefers-reduced-motion: reduce) {
    .pillar-fade,
    .metric-card-enter,
    .gauge-animate,
    .accent-pulse,
    .drift-float,
    .stagger-item,
    .pulse-healthy,
    .pulse-stale,
    .pulse-error,
    .bento-hover {
        animation: none;
        transition: none;
    }
}
