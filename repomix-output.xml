                            handleUnassignClient={handleUnassignClient}
                        />
                    )}
                    {activeTab === 'team' && <TeamTab />}
                    {activeTab === 'billing' && <BillingTab userPlan={userPlan} />}
                    {activeTab === 'api' && (
                        <ApiKeysTab
