# Environment Configuration

# Database (Neon Postgres)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (Email Verification)
# Get your API key at https://resend.com
RESEND_API_KEY="re_..."

# LemonSqueezy (primary payment gateway — Merchant of Record)
# Create your account at https://app.lemonsqueezy.com
# API key: Settings → API → New API key
LEMONSQUEEZY_API_KEY=""
# Store ID: Settings → Store (shown at top of page)
LEMONSQUEEZY_STORE_ID="918482"
# Variant IDs: Products → click product → Variants tab
LEMONSQUEEZY_STARTER_VARIANT_ID="1444235"
LEMONSQUEEZY_PRO_VARIANT_ID="1444209"
# Webhook signing secret: Settings → Webhooks → your webhook (6-40 chars, you choose)
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Xendit (Invoices / checkout) — set for Production + Preview in Vercel
XENDIT_SECRET_KEY="xnd_development_..."
# Optional: verify invoice webhooks (Dashboard → Webhooks → callback token)
XENDIT_WEBHOOK_TOKEN=""
# Default checkout currency when the client does not send one (pricing page sends VND or USD).
XENDIT_DEFAULT_CURRENCY="VND"
# Convert USD list prices → VNĐ for invoices (tune to your FX policy)
XENDIT_VND_PER_USD="25000"
# Optional: IDR only if you set XENDIT_DEFAULT_CURRENCY=IDR or pass currency from a custom client
XENDIT_IDR_PER_USD="16500"

# TikTok Shop Open Connect (server only — never NEXT_PUBLIC the secret)
# App ID from Partner Center = TIKTOK_SHOP_APP_KEY (app_key)
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
# Optional: must exactly match URL registered in TikTok Developer Console
# TIKTOK_SHOP_REDIRECT_URI="https://yourdomain.com/api/auth/tiktok/callback"

# TikTok Business / Marketing API (business-api.tiktok.com/portal)
# NOTE: This is the Marketing API portal — NOT the Login Kit / open.tiktokapis.com portal.
# Register your app at: https://business-api.tiktok.com/portal
# Auth URL : https://ads.tiktok.com/marketing_api/auth
# Token URL: https://business-api.tiktok.com/open_api/v1.3/oauth2/access_token/
# BOTH app_id and secret are required — the connector is hidden if either is missing.
TIKTOK_BUSINESS_CLIENT_KEY=""         # app_id from portal (also accepted as TIKTOK_BUSINESS_APP_ID)
TIKTOK_BUSINESS_CLIENT_SECRET=""      # secret from portal (also accepted as TIKTOK_BUSINESS_APP_SECRET)
# Optional: override default callback URL (must match URL registered in the portal)
# TIKTOK_BUSINESS_REDIRECT_URI="https://yourdomain.com/api/auth/tiktok-business/callback"

# Hide connectors from dashboard + block OAuth (set to "false" to disable)
# TIKTOK_SHOP_CONNECT_ENABLED="true"
# TIKTOK_BUSINESS_CONNECT_ENABLED="true"

# Google Sheets add-on: comma-separated Google account emails treated as Professional
# for Marketplace review (no billing change). User must still exist in DB + have connections.
# MONSTERA_SHEETS_REVIEW_EMAILS="reviewer@gmail.com,other@yourdomain.com"
