# Environment Configuration

# Meta (Facebook) Pixel — client-side events (Events Manager). Optional override; defaults in layout if unset.
# NEXT_PUBLIC_META_PIXEL_ID="1678503466639816"
# Events Manager → Pixel → Test events — paste the "test event code" so hits appear in the Test events tab (esp. on localhost).
# NEXT_PUBLIC_META_TEST_EVENT_CODE="TEST12345"

# Database (Neon Postgres)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Smoke test account (script: npm run create-smoke-user — pre-verified email, no OTP)
# SMOKE_TEST_EMAIL="smoke-test@monsteracloud.com"
# SMOKE_TEST_PASSWORD="your-long-secret-here"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
# Local: http://localhost:3000 | Production (MonsteraCloud.com): https://monsteracloud.com
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (Email Verification)
# Get your API key at https://resend.com
RESEND_API_KEY="re_..."

# Paddle Billing (optional MoR — set NEXT_PUBLIC_PAYMENT_PROVIDER=paddle to use)
# Dashboard: https://vendors.paddle.com — live keys under Production; test keys under Sandbox
# Webhooks: https://developer.paddle.com/webhooks/overview
PADDLE_API_KEY=""
# Secret from Developer Tools → Notifications → your webhook destination (endpoint secret)
PADDLE_WEBHOOK_SECRET=""
# Optional: sandbox | production. If unset: Vercel Production → live API; preview/local → sandbox.
# Force live everywhere: PADDLE_ENVIRONMENT="production"
PADDLE_ENVIRONMENT=""
# Catalog price IDs (pri_...) — Starter/Pro × monthly/annual from Paddle Products → Prices
PADDLE_PRICE_STARTER_MONTHLY=""
PADDLE_PRICE_STARTER_ANNUAL=""
PADDLE_PRICE_PROFESSIONAL_MONTHLY=""
PADDLE_PRICE_PROFESSIONAL_ANNUAL=""
# Client checkout: defaults to Paddle. Set to lemonsqueezy only if you use LemonSqueezy.
# NEXT_PUBLIC_PAYMENT_PROVIDER="lemonsqueezy"

# LemonSqueezy (primary payment gateway — Merchant of Record)
# Create your account at https://app.lemonsqueezy.com
# API key: Settings → API → New API key
LEMONSQUEEZY_API_KEY=""
# Store ID: Settings → Store (shown at top of page)
LEMONSQUEEZY_STORE_ID="918482"
# Variant IDs: Products → click product → Variants tab
LEMONSQUEEZY_STARTER_VARIANT_ID="1444235"
LEMONSQUEEZY_PRO_VARIANT_ID="1444209"
# Webhook signing secret: Settings → Webhooks → your webhook (6-40 chars, you choose)
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Xendit (Invoices / checkout) — set for Production + Preview in Vercel
XENDIT_SECRET_KEY="xnd_development_..."
# Optional: verify invoice webhooks (Dashboard → Webhooks → callback token)
XENDIT_WEBHOOK_TOKEN=""
# Default checkout currency when the client does not send one (pricing page sends VND or USD).
XENDIT_DEFAULT_CURRENCY="VND"
# Convert USD list prices → VNĐ for invoices (tune to your FX policy)
XENDIT_VND_PER_USD="25000"
# Optional: IDR only if you set XENDIT_DEFAULT_CURRENCY=IDR or pass currency from a custom client
XENDIT_IDR_PER_USD="16500"

# TikTok Shop Open Connect (server only — never NEXT_PUBLIC the secret)
# App ID from Partner Center = TIKTOK_SHOP_APP_KEY (app_key)
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
# Optional: must exactly match URL registered in TikTok Developer Console
# TIKTOK_SHOP_REDIRECT_URI="https://monsteracloud.com/api/auth/tiktok/callback"

# TikTok Business / Marketing API (business-api.tiktok.com/portal)
# NOTE: This is the Marketing API portal — NOT the Login Kit / open.tiktokapis.com portal.
# Register your app at: https://business-api.tiktok.com/portal
# Auth URL : https://ads.tiktok.com/marketing_api/auth
# Token URL: https://business-api.tiktok.com/open_api/v1.3/oauth2/access_token/
# BOTH app_id and secret are required — the connector is hidden if either is missing.
TIKTOK_BUSINESS_CLIENT_KEY=""         # app_id from portal (also accepted as TIKTOK_BUSINESS_APP_ID)
TIKTOK_BUSINESS_CLIENT_SECRET=""      # secret from portal (also accepted as TIKTOK_BUSINESS_APP_SECRET)
# Optional: override default callback URL (must match URL registered in the portal)
# TIKTOK_BUSINESS_REDIRECT_URI="https://monsteracloud.com/api/auth/tiktok-business/callback"

# Hide connectors from console + block OAuth (set to "false" to disable)
# TIKTOK_SHOP_CONNECT_ENABLED="true"
# TIKTOK_BUSINESS_CONNECT_ENABLED="true"

# Google Ads API (OAuth app from console.cloud.google.com, developer token from ads.google.com/aw/apicenter)
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Optional: override default callback (must match Google Cloud → Credentials → OAuth client → Authorized redirect URIs)
# GOOGLE_ADS_REDIRECT_URI="https://monsteracloud.com/api/auth/google-ads/callback"
GOOGLE_ADS_CONNECT_ENABLED="true"

# Meta (Facebook) Ads — app from developers.facebook.com
META_ADS_APP_ID=""
META_ADS_APP_SECRET=""
# Optional: override default callback (must match Meta → Facebook Login → Valid OAuth Redirect URIs)
# META_ADS_REDIRECT_URI="https://monsteracloud.com/api/auth/meta-ads/callback"
META_ADS_CONNECT_ENABLED="true"

# ── OAuth callback paths (register EXACTLY in each console; copy from /api/integrations/config in the app) ──
#
# Meta (Facebook Login): developers.facebook.com → Your App → Use cases → Facebook Login → Settings
#   → "Valid OAuth Redirect URIs"
#
# Google: console.cloud.google.com → APIs & Services → Credentials → your OAuth 2.0 Client ID
#   → "Authorized redirect URIs"
#
# Default paths (prefix = NEXTAUTH_URL origin, no trailing slash — or your META_/GOOGLE_ADS_REDIRECT_URI if set):
#   /api/auth/meta-ads/callback
#   /api/auth/google-ads/callback
#
# Local dev (port 3000):
#   http://localhost:3000/api/auth/meta-ads/callback
#   http://localhost:3000/api/auth/google-ads/callback
#
# Production (MonsteraCloud.com):
#   https://monsteracloud.com/api/auth/meta-ads/callback
#   https://monsteracloud.com/api/auth/google-ads/callback

# Google Sheets add-on: comma-separated Google account emails treated as Professional
# for Marketplace review (no billing change). User must still exist in DB + have connections.
# MONSTERA_SHEETS_REVIEW_EMAILS="reviewer@gmail.com,other@yourdomain.com"

# Telegram — sync failure alerts (pipeline run errors). Bot token is global; chat ID can be per-workspace in Settings.
# TELEGRAM_BOT_TOKEN=""
# Optional default chat if workspace has no telegramChatId set:
# TELEGRAM_CHAT_ID=""

# AI — Overview “digest” (OpenAI). Cheap default: gpt-4o-mini. Optional: AI_SUMMARY_MODEL override.
# OPENAI_API_KEY="sk-..."
# AI_SUMMARY_MODEL="gpt-4o-mini"
